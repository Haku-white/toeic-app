# ask-tutor Edge Function のローカル動作確認用（`supabase functions serve --env-file supabase/functions/.env`）。
# 実際の値を入れたファイルは `supabase/functions/.env` として作成し、コミットしないこと
# （ルートの.gitignoreの `.env` パターンが全階層にマッチするため既に対象）。
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY は `supabase status -o env` の値をそのまま使う。
# GEMINI_API_KEY は Google AI Studio (https://aistudio.google.com/apikey) で発行したキー。
# クラウド環境向けには `supabase secrets set` で別途設定する（22.8、実行前に要確認）。

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# 省略可。既定値は gemini-3.6-flash
GEMINI_MODEL=
