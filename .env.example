# このファイルは.env（gitignore済み、プロジェクトルート）の雛形です。
# 実際の値は.envに設定してください。.env.exampleにはダミー値のみを記載します。

# --- フロントエンド（Vite）用。ローカルでは.env.localに設定し常にローカルSupabaseを指す運用（CLAUDE.md参照）。
#     Vercel等にデプロイする場合はこの2つをビルド環境の環境変数として登録する（値はクラウドSupabaseの
#     Project Settings > API から取得。ANON_KEYはpublicキーでRLS前提のため公開して問題ない。
#     SERVICE_ROLE_KEY/SECRET_KEYは絶対にVITE_接頭辞を付けない＝絶対にフロントに含めないこと） ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase ローカル開発用（Google OAuth、supabase/config.tomlのenv()参照） ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- scripts/content-generation 用（8章のGemini APIバッチ生成パイプライン） ---
# ローカル: `supabase status -o env` で取得できる値をそのまま使えます（固定のデモ値、非シークレット）。
# クラウド向けに実行する場合は、Supabaseダッシュボードの Project Settings > API から
# 該当プロジェクトのURL/service_roleキーに置き換えてください（service_roleキーは強力な権限を
# 持つため絶対にコミットしない・共有しないこと）。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (https://aistudio.google.com/apikey) で発行したAPIキー
GEMINI_API_KEY=

# 省略可。既定値は gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
